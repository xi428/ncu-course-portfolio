# =====================================================
# .gitignore for NCU 个人课程作品集（跨学科通用版）
# =====================================================

# --------------- 操作系统 ---------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
._*
.Spotlight-V100
.Trashes

# --------------- IDE / 编辑器 ---------------
# JetBrains 系列（IntelliJ IDEA / PyCharm / WebStorm ...）
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse / MyEclipse
.project
.classpath
.settings/
.factorypath
.loadpath

# Sublime Text
*.sublime-project
*.sublime-workspace

# --------------- 编程语言运行时与构建产物 ---------------
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Java
*.class
*.jar
*.war
*.ear
target/

# C / C++
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# R 语言
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --------------- 日志 ---------------
*.log
logs/

# --------------- 环境变量与密钥（绝对不能上传！） ---------------
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12
secrets.yaml

# --------------- 临时与缓存文件 ---------------
*.tmp
*.bak
*.swp
*.swo
*~
.cache/
tmp/
temp/

# --------------- Office / 数据文件锁 ---------------
~$*
*.tmp

# --------------- 大型资源与压缩包 ---------------
*.7z
*.dmg
*.iso
*.tar
*.tar.gz
*.zip

# --------------- 数据库 ---------------
*.db
*.sqlite
*.sqlite3

# --------------- 课程作业常见临时文件 ---------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
